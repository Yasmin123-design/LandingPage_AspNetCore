## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Visual Studio Code
.vscode/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Publish profiles
*.pubxml
*.pubxml.user

# NuGet Packages
*.nupkg
[Pp]ackages/
## The *.nuget.props and *.nuget.targets files are auto-generated
## by msbuild and shouldn't be tracked.
*.nuget.props
*.nuget.targets

# Mac/Linux hidden files
.DS_Store
.AppleDouble
.LSOverride

# Directories potentially created on Mac OS X via Finder
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Node
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
.pnpm-debug.log*

# Other tools
*.swp
*.*~
project.lock.json
.DS_Store
*.pyc

# Local environments
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
